<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>mframe-fs</AssemblyName>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <WinFspInstallDir Condition="'$(WinFspInstallDir)' == '' and '$(OS)' == 'Windows_NT'">$([MSBuild]::GetRegistryValueFromView('HKEY_LOCAL_MACHINE\SOFTWARE\WinFsp', 'InstallDir', null, RegistryView.Registry32))</WinFspInstallDir>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Mainframe.Client/Mainframe.Client.csproj" />
    <ProjectReference Include="../Mainframe.Protocol/Mainframe.Protocol.csproj" />
    <Reference Include="winfsp-msil">
      <HintPath>$(WinFspInstallDir)/bin/winfsp-msil.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <None Include="../../LICENSE" Link="LICENSE" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CheckWinFsp" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(WinFspInstallDir)/bin/winfsp-msil.dll')" Text="WinFsp 2.1.25156 with its .NET binding is required. Install the official runtime/developer components or set -p:WinFspInstallDir=PATH." />
  </Target>
</Project>
